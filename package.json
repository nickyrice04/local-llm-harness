{
  "name": "seymour-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Seymour's browser UI: TypeScript sources in frontend/, built to static/app.js.",
  "scripts": {
    "build": "esbuild frontend/src/main.ts --bundle --minify --outfile=static/app.js --format=iife --target=es2022",
    "watch": "esbuild frontend/src/main.ts --bundle --outfile=static/app.js --format=iife --target=es2022 --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.10"
  }
}
