# Copy to .env and adjust. Every value here maps to a field in
# seymour/config.py (prefix SEYMOUR_). The .gitignore keeps .env out of
# git — this example file, with no real values, documents the shape.

# The chat model to serve (any .gguf). The Models tab can also set this.
SEYMOUR_MODEL_PATH=/absolute/path/to/model.gguf

# llama-server knobs (defaults shown; see seymour/config.py for the why).
#SEYMOUR_N_SLOTS=4
#SEYMOUR_CTX_SIZE=32768
#SEYMOUR_LLAMA_PORT=8080

# Scheduler knobs.
#SEYMOUR_AGENT_FLOOR_SLOTS=1
#SEYMOUR_AGENT_FLOOR_SHARE=0.15
#SEYMOUR_TIER2_MAX_SLOTS=2
#SEYMOUR_CONCURRENCY_THRESHOLD=1.5

# Optional tiny embedding model for semantic memory (falls back to a
# dependency-free embedder when absent).
#SEYMOUR_EMBED_MODEL_PATH=/absolute/path/to/embeddings.gguf
