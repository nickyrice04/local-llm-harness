{
  "compilerOptions": {
    // Modern output — Seymour targets current browsers on the same machine.
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    // Strictness catches the bugs a chat UI actually has (nulls, typos).
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // esbuild does the emitting; tsc is typecheck-only (npm run typecheck).
    "noEmit": true,
    "lib": ["es2022", "dom", "dom.iterable"]
  },
  "include": ["frontend/src/**/*.ts"]
}
